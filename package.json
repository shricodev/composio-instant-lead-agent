{
  "name": "inbound-enrichment-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Inbound lead enrichment agent built on Composio Instant",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "discover": "tsx --env-file-if-exists=.env src/discoverTools.ts",
    "verify-sdk": "tsx --env-file-if-exists=.env src/scripts/verifySdk.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "sample": "tsx --env-file-if-exists=.env src/scripts/runSample.ts",
    "report": "tsx --env-file-if-exists=.env src/scripts/reportCosts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "connect": "tsx --env-file-if-exists=.env src/scripts/connect.ts",
    "lead": "tsx --env-file-if-exists=.env src/scripts/runLead.ts",
    "calendly": "tsx --env-file-if-exists=.env src/scripts/setupCalendly.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/scripts/reportCosts.ts --reconcile"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@composio/anthropic": "^0.11.6",
    "@composio/core": "^0.27.0",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
