# --- Required ---
# Project API key from the Composio dashboard (Settings -> API keys)
COMPOSIO_API_KEY=
ANTHROPIC_API_KEY=

# Workspace/tenant running this service (NOT the lead). Use a fresh id so
# pre-existing personal connections (e.g. a private Exa key) don't hijack routing.
COMPOSIO_USER_ID=instant_demo_workspace

# --- Models ---
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-5-5

# --- Spend controls (USD) ---
TIER1_BUDGET_USD=0.30
TIER2_BUDGET_USD=0.50
TIER2_MAX_ITERATIONS=6
# Hard ceiling on cumulative Instant spend recorded in the local ledger
DEV_SPEND_CAP_USD=1.50
HOT_THRESHOLD=75
# Kill switch seed: false = never use Instant (own accounts only)
INSTANT_ENABLED=true
# Force account: "instant_account" on paid calls. Off by default: the live API
# rejected it on our project (see BUILD_NOTES.md); routing priority is used instead.
INSTANT_EXPLICIT_ACCOUNT=false

# --- Outputs ---
CRM=sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Channel ID preferred (e.g. C0ABC12345); a bare name like inbound-leads also works
SLACK_CHANNEL=

# --- Optional ---
# Composio Firewall prompt-injection check on scraped content (paid, usage-priced)
FIREWALL_ENABLED=false
# Composio webhook signing secret (for the Calendly trigger route)
COMPOSIO_WEBHOOK_SECRET=
# Shared secret your signup form sends in the x-webhook-secret header
SIGNUP_WEBHOOK_SECRET=
# Same email within this many minutes = duplicate (no second spend)
DEDUPE_WINDOW_MINUTES=1440
# Leads processed in parallel by the server
CONCURRENCY=1
# Protects /admin endpoints
ADMIN_TOKEN=
PORT=3000
DB_PATH=data/enrichment.db
